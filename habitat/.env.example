# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgres://habitat:habitat@localhost:5432/habitat
TEST_DATABASE_URL=postgres://habitat:habitat@localhost:5433/habitat_test

# Better Auth
BETTER_AUTH_SECRET=                 # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email: console (prints links in the terminal) | outbox (tests) | resend (production)
EMAIL_TRANSPORT=console
RESEND_API_KEY=
EMAIL_FROM="Habitat <hello@example.com>"

# Cron (Vercel sends it as a Bearer token)
CRON_SECRET=

# Storage and realtime are optional in v1: without them photos are disabled and chat polls.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=habitat-media
# ABLY_API_KEY=
