# Database. Leave unset in development to use a local file-backed PGlite database in .data/.
# In production use a Postgres 16 URL with the pgvector extension (e.g. Neon).
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google sign-in (optional in development; guests work without it)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Catalogue pipeline (scripts only)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
UNSPLASH_ACCESS_KEY=
AWIN_FEED_URLS=

# Email, analytics, errors (optional)
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SENTRY_DSN=

CRON_SECRET=
UNSUBSCRIBE_SECRET=
ADMIN_EMAILS=
